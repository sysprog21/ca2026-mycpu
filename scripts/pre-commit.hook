#!/usr/bin/env bash
# SPDX-License-Identifier: MIT

# Checks the staged files before a commit: conflict markers, whitespace errors,
# binary and non-ASCII file names, C and C++ formatting, and the syntax of shell
# and Python scripts. Scala formatting is left to "make check-format", because
# scalafmt needs sbt and takes minutes.

# Ensure that the common script exists and is readable, then verify it has no
# syntax errors and defines the required function.
common_script="$(dirname "$0")/../../scripts/common.sh"
[ -r "$common_script" ] || { echo "[!] '$common_script' not found or not readable." >&2; exit 1; }
bash -n "$common_script" >/dev/null 2>&1 || { echo "[!] '$common_script' contains syntax errors." >&2; exit 1; }
source "$common_script"
declare -F set_colors >/dev/null 2>&1 || { echo "[!] '$common_script' does not define the required function." >&2; exit 1; }

set_colors

# The formatting pin is the Makefile's: override only for a dry run.
# Found by version: clang-format-20, a pipx install and the like count, not only the first on PATH.
CLANG_FORMAT="$(find_clang_format || echo "${CLANG_FORMAT:-clang-format}")"

RETURN=0
ERRORS_FOUND=()
WARNINGS_FOUND=()

TOTAL_CHECKS=7
CURRENT_CHECK=0

update_progress() {
  local check_name="$1"
  ((CURRENT_CHECK++))
  printf "\r${CYAN}[%d/%d]${NC} %s..." "$CURRENT_CHECK" "$TOTAL_CHECKS" "$check_name"
}

report_result() {
  local status="$1"
  local message="$2"
  if [ "$status" -eq 0 ]; then
    printf " [ ${GREEN}OK${NC} ]\n"
  else
    printf " [ ${RED}FAIL${NC} ]\n"
    if [ -n "$message" ]; then
      ERRORS_FOUND+=("$message")
    fi
  fi
}

printf "${CYAN}Running pre-commit checks...${NC}\n\n"

workspace=$(git rev-parse --show-toplevel)

# Staged files that are added, copied or modified; a tool that is missing is
# reported once, never silently skipped.
FILES=()
while IFS= read -r -d '' f; do FILES+=("$f"); done < <(git diff --cached --name-only -z --diff-filter=ACMR)

if [ ${#FILES[@]} -eq 0 ]; then
  printf "${YELLOW}No files staged for commit.${NC}\n"
  exit 0
fi

# CHECK 1: Workspace path
update_progress "Checking workspace path"
if echo "$workspace" | LC_ALL=C grep -q "[一-龥]"; then
  report_result 1 "Workspace path contains non-ASCII characters"
  RETURN=1
else
  report_result 0
fi

# CHECK 2: Merge conflict markers
update_progress "Checking for merge conflicts"
CONFLICT_MARKERS=$(printf '%s|%s|%s' "<<<<<<<" "=======" ">>>>>>>")
CONFLICT_FILES=$(git diff --cached --name-only -G "${CONFLICT_MARKERS}" |
  grep -vE '(^|/)\.git/hooks/|(^|/)(pre-commit|commit-msg|prepare-commit-msg|pre-push)\.hook$|(^|/)scripts/commit-msg\.hook$')
if [ -n "${CONFLICT_FILES}" ]; then
  report_result 1 "Conflict markers found in: ${CONFLICT_FILES}"
  RETURN=1
else
  report_result 0
fi

# CHECK 3: Whitespace errors in the staged change (trailing space, a space
# before a tab, a blank line at the end of a file)
update_progress "Checking whitespace"
if ws=$(git diff --cached --check 2>&1); then
  report_result 0
else
  report_result 1 "Whitespace errors (run: git diff --cached --check): $(echo "$ws" | head -n 3 | tr '\n' ' ')"
  RETURN=1
fi

# CHECK 4: Binary files. A binary file is committed only when .gitattributes declares it
# (`binary`, as for the golden frames and the pipeline diagrams); any other one is refused.
update_progress "Checking for binary files"
binary_files=()
for file in "${FILES[@]}"; do
  # an empty file is not binary, though `file` calls its charset binary
  if [ -s "$file" ] && file --mime "$file" 2>/dev/null | grep -qi 'charset=binary'; then
    [ "$(git check-attr binary -- "$file" | sed 's/.*: binary: //')" = set ] && continue
    binary_files+=("$file")
  fi
done
if [ ${#binary_files[@]} -gt 0 ]; then
  report_result 1 "Binary files not declared in .gitattributes (binary): ${binary_files[*]}"
  RETURN=1
else
  report_result 0
fi

# CHECK 5: C and C++ formatting, on the staged content
update_progress "Checking C and C++ formatting"
# Only this repository's own files are formatted (the Makefile's FORMAT_C): the
# benchmarks keep the formatting of their upstream.
C_FILES=()
FORMATTED=$(make -s --no-print-directory format-c-files 2>/dev/null)
for file in "${FILES[@]}"; do
  case "$file" in
    *.c | *.cc | *.cpp | *.h | *.hpp) grep -qxF -- "$file" <<<"$FORMATTED" && C_FILES+=("$file") ;;
  esac
done
formatting_errors=0
if [ ${#C_FILES[@]} -gt 0 ]; then
  if ! command -v "$CLANG_FORMAT" >/dev/null 2>&1; then
    report_result 1 "$CLANG_FORMAT not found: install clang-format $CLANG_FORMAT_REQUIRED (pipx install clang-format==20.1.8; docs/toolchain.md)"
    RETURN=1
  elif [ "$(clang_format_major "$CLANG_FORMAT")" != "$CLANG_FORMAT_REQUIRED" ]; then
    report_result 1 "clang-format $CLANG_FORMAT_REQUIRED is required, found '$(clang_format_major "$CLANG_FORMAT")' (pipx install clang-format==20.1.8; docs/toolchain.md)"
    RETURN=1
  else
    for file in "${C_FILES[@]}"; do
      # The staged blob, formatted with the .clang-format that is staged too.
      if ! git show ":$file" | "$CLANG_FORMAT" --assume-filename="$workspace/$file" 2>/dev/null |
        cmp -s - <(git show ":$file"); then
        formatting_errors=$((formatting_errors + 1))
        WARNINGS_FOUND+=("$file needs formatting (run: $CLANG_FORMAT -i $file)")
      fi
    done
    if [ $formatting_errors -gt 0 ]; then
      report_result 1 "$formatting_errors file(s) need formatting"
      RETURN=1
    else
      report_result 0
    fi
  fi
else
  report_result 0
fi

# CHECK 6: Shell and Python syntax
update_progress "Checking script syntax"
syntax_errors=0
for file in "${FILES[@]}"; do
  [ -f "$file" ] || continue
  case "$file" in
    *.sh | *.hook | scripts/install-git-hooks)
      bash -n "$file" 2>/dev/null || { syntax_errors=$((syntax_errors + 1)); ERRORS_FOUND+=("Shell syntax error in $file"); } ;;
    *.py)
      python3 -I -c 'import ast,sys; ast.parse(open(sys.argv[1], "rb").read())' "$file" 2>/dev/null ||
        { syntax_errors=$((syntax_errors + 1)); ERRORS_FOUND+=("Python syntax error in $file"); } ;;
  esac
done
if [ $syntax_errors -gt 0 ]; then
  report_result 1 "$syntax_errors script(s) do not parse"
  RETURN=1
else
  report_result 0
fi

# CHECK 7: Non-ASCII filenames
update_progress "Checking filenames"
if test "$(git diff --cached --name-only --diff-filter=ACR -z |
  LC_ALL=C tr -d '[ -~]\0' | wc -c | tr -d ' ')" != 0; then
  report_result 1 "Non-ASCII filename detected"
  RETURN=1
else
  report_result 0
fi

# Clear the progress line
printf "\r%*s\r" 50 ""
printf "\n"

printf "${CYAN}Files to be committed:${NC}\n"
for file in "${FILES[@]}"; do
  summary=$(git diff --cached --numstat -- "$file" 2>/dev/null | awk '{
    if ($1 != "0" && $2 != "0")
      printf "+%s/-%s", $1, $2;
    else if ($1 != "0")
      printf "+%s", $1;
    else if ($2 != "0")
      printf "-%s", $2;
  }')
  if [ -n "$summary" ]; then
    printf "  ${WHITE}%-40s${NC} ${GREEN}%s${NC}\n" "$file" "$summary"
  else
    printf "  ${WHITE}%s${NC}\n" "$file"
  fi
done

if [ ${#ERRORS_FOUND[@]} -gt 0 ]; then
  printf "\n${RED}Errors found:${NC}\n"
  for error in "${ERRORS_FOUND[@]}"; do
    printf "  [ ${RED}FAIL${NC} ] %s\n" "$error"
  done
fi

if [ ${#WARNINGS_FOUND[@]} -gt 0 ]; then
  printf "\n${YELLOW}Warnings:${NC}\n"
  for warning in "${WARNINGS_FOUND[@]}"; do
    printf "  ${YELLOW}!${NC} %s\n" "$warning"
  done
fi

if [ $RETURN -eq 0 ]; then
  printf "\n${GREEN}All checks passed!${NC}\n"
else
  printf "\n${RED}Pre-commit checks failed. Please fix the issues above.${NC}\n"
fi

exit $RETURN
